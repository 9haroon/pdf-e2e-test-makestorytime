{
  "name": "makestory-backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/api/server.js",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "tsx --test tests/unit/**/*.test.ts",
