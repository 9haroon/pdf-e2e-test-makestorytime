# PostgreSQL connection (Prisma)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/makestory?schema=public"

# Google AI (Gemini) — required for production story and image generation
GEMINI_API_KEY=""

# Optional: override default text model (e.g. gemini-2.0-flash)
GEMINI_TEXT_MODEL="gemini-2.0-flash"

# Optional: used when the configured model can return image bytes
GEMINI_IMAGE_MODEL=""

# Server
PORT=4000
NODE_ENV=development

# Base URL used when storing locally generated assets (must match how the API is reached)
PUBLIC_API_BASE_URL="http://localhost:4000"

# Local file storage directory (image upload fallback when no S3/GCS configured)
LOCAL_IMAGE_STORAGE_DIR="./storage/images"
